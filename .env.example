DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autoluz_laravel
DB_USERNAME=root
DB_PASSWORD=

WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_USER=root
WP_DB_PASSWORD=
WP_DB_NAME=wordpress
WP_TABLE_PREFIX=wp_

YOUTUBE_CHANNEL_ID=UCPvSp1UdLh9QC7XXMTgpNjQ
YOUTUBE_CHANNEL_URL=https://youtube.com/@apihmototv
YOUTUBE_CHANNEL_NAME="apih mototv"
YOUTUBE_IMPORT_LIMIT=2000
YOUTUBE_SHORTS_ONLY=true
YOUTUBE_SHORTS_MAX_PAGES=50
YOUTUBE_CACHE_TTL=1800

SOCIAL_YOUTUBE_URL=https://youtube.com/@apihmototv
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/abaygunawan
SOCIAL_FACEBOOK_URL=https://www.facebook.com/share/1MibTVCTM8/
